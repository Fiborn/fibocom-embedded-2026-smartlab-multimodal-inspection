# ============================================
# 环境变量示例:复制为 .env 并填写真实值
# (cloud/web_frontend/sever.js 读取)
# ============================================

# 华为云账号 AK/SK(访问密钥)
HUAWEICLOUD_AK=your_access_key
HUAWEICLOUD_SK=your_secret_key

# 华为云 IoTDA 接入信息
HUAWEICLOUD_PROJECT_ID=your_project_id
IOTDA_DEVICE_ID=your_product_id_your_device
IOTDA_INSTANCE_ID=your_instance_id
IOTDA_ENDPOINT=your_instance.iotda-app.cn-north-4.myhuaweicloud.com

# 通义千问大模型 API Key
QWEN_API_KEY=your_qwen_api_key

# MySQL 数据库
DB_PASSWORD=your_password

# QQ 邮箱 SMTP(用于邮件告警)
SENDER_EMAIL=your_email@qq.com
SENDER_PASS=your_smtp_authorization_code
TEACHER_EMAIL=your_email@qq.com

# 机器人 Web Bridge 地址(边缘端)
ROBOT_BRIDGE_URL=http://192.168.1.100:5000
