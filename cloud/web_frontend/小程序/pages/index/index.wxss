page {
  padding-bottom: 140rpx;
}

/* 顶部横幅 */
.header {
  position: relative;
  background: linear-gradient(160deg, #3f8ae2 0%, #6db3f5 58%, #8ec9fa 100%);
  padding: 70rpx 40rpx 130rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  overflow: hidden;
}

.deco {
  position: absolute;
  border-radius: 50%;
}

.d1 {
  width: 300rpx;
  height: 300rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.45), transparent 70%);
  top: -90rpx;
  right: -70rpx;
}

.d2 {
  width: 220rpx;
  height: 220rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.38), transparent 70%);
  bottom: -80rpx;
  left: -50rpx;
}

.d3 {
  width: 60rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.55);
  top: 120rpx;
  right: 220rpx;
}

.greet {
  color: #fff;
  font-size: 38rpx;
  font-weight: 700;
}

.chip-line {
  display: flex;
  margin-top: 16rpx;
}

.id-chip {
  background: rgba(255, 255, 255, 0.16);
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  color: #fff;
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 24rpx;
  margin-right: 14rpx;
}

.avatar {
  width: 116rpx;
  height: 116rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
  border: 3rpx solid rgba(255, 255, 255, 0.5);
  color: #fff;
  font-size: 50rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 绑定卡片 */
.bind-card {
  margin-top: -80rpx;
  display: flex;
  align-items: center;
}

.bind-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 26rpx;
  background: linear-gradient(135deg, #e6f1fd, #d4e7fc);
  font-size: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 22rpx;
}

.bind-info {
  flex: 1;
}

.bind-lab {
  font-size: 32rpx;
  font-weight: 700;
  color: #1b2a4a;
}

.bind-sub {
  font-size: 25rpx;
  color: #7a869e;
  margin-top: 8rpx;
}

/* 工位状态 */
.status-grid {
  display: flex;
  flex-wrap: wrap;
}

.status-item {
  width: 33.33%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 18rpx 0;
}

.s-icon {
  font-size: 40rpx;
  margin-bottom: 6rpx;
}

.s-label {
  font-size: 23rpx;
  color: #98a3b8;
}

.s-value {
  margin-top: 8rpx;
  font-size: 28rpx;
  font-weight: 700;
  padding: 4rpx 20rpx;
  border-radius: 22rpx;
  background: #f4f7fc;
}

.s-value.ok { background: #e4f8ef; }
.s-value.warn { background: #fff3e2; }
.s-value.bad { background: #ffe9ec; }

/* 快捷功能 */
.grid {
  display: flex;
  flex-wrap: wrap;
}

.grid-item {
  width: 33.33%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 26rpx 0 10rpx;
}

.grid-item text {
  font-size: 25rpx;
  margin-top: 14rpx;
  color: #44506b;
}

/* 公告 */
.more {
  margin-left: auto;
  color: #98a3b8;
  font-size: 24rpx;
  font-weight: 400;
}

.notice {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f3f9;
}

.notice:last-child {
  border-bottom: none;
}

.notice-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #3b82f6, #7fc0f7);
  margin-right: 18rpx;
  flex-shrink: 0;
}

.notice-body {
  flex: 1;
}

.notice-title {
  font-size: 27rpx;
  color: #2b3550;
}

.notice-time {
  font-size: 21rpx;
  color: #98a3b8;
  margin-top: 6rpx;
}

.notice-arrow {
  color: #c4ccda;
  font-size: 32rpx;
  margin-left: 12rpx;
}
