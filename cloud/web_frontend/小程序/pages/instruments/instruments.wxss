.guide-card {
  position: relative;
  margin: 24rpx 28rpx;
  background: #fff;
  border-radius: 28rpx;
  padding: 30rpx 30rpx 30rpx 42rpx;
  box-shadow: 0 10rpx 30rpx rgba(23, 61, 156, 0.08);
  overflow: hidden;
}

.g-accent {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 12rpx;
  background: linear-gradient(180deg, #3b82f6, #7fc0f7);
}

.g-head {
  display: flex;
  align-items: center;
}

.g-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #e6f1fd, #d4e7fc);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  margin-right: 20rpx;
}

.g-name {
  flex: 1;
  font-size: 31rpx;
  font-weight: 700;
  color: #1b2a4a;
}

.arrow {
  color: #9aa5ba;
  font-size: 34rpx;
  transition: transform 0.25s;
}

.arrow.open {
  transform: rotate(180deg);
}

.g-content {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx dashed #e6ecf7;
  font-size: 27rpx;
  color: #5a6780;
  line-height: 1.8;
  white-space: pre-line;
}
