.login-wrap {
  min-height: 100vh;
  box-sizing: border-box;
  background: linear-gradient(165deg, #6db0f2 0%, #a3cdf7 55%, #d9eafd 100%);
  padding: 110rpx 56rpx 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  overflow: hidden;
}

.deco {
  position: absolute;
  border-radius: 50%;
}

.d1 {
  width: 340rpx;
  height: 340rpx;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.55), transparent 70%);
  top: -100rpx;
  right: -100rpx;
}

.d2 {
  width: 260rpx;
  height: 260rpx;
  background: radial-gradient(circle, rgba(59, 130, 246, 0.16), transparent 70%);
  bottom: -80rpx;
  left: -80rpx;
}

.d3 {
  width: 50rpx;
  height: 50rpx;
  background: rgba(59, 130, 246, 0.25);
  top: 230rpx;
  left: 80rpx;
}

.logo-ring {
  width: 170rpx;
  height: 170rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.7);
  border: 3rpx solid rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 28rpx;
  box-shadow: 0 16rpx 40rpx rgba(59, 130, 246, 0.22);
}

.logo {
  font-size: 84rpx;
}

.app-name {
  color: #16407a;
  font-size: 48rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.tabs {
  display: flex;
  width: 100%;
  margin: 64rpx 0 36rpx;
  background: rgba(255, 255, 255, 0.55);
  border: 1rpx solid rgba(255, 255, 255, 0.85);
  border-radius: 48rpx;
  padding: 8rpx;
  box-sizing: border-box;
}

.tab {
  flex: 1;
  text-align: center;
  line-height: 76rpx;
  border-radius: 42rpx;
  color: #4a6a9a;
  font-size: 30rpx;
}

.tab.active {
  background: #fff;
  color: #3b82f6;
  font-weight: 700;
  box-shadow: 0 8rpx 20rpx rgba(59, 130, 246, 0.18);
}

.form {
  width: 100%;
  background: #ffffff;
  border-radius: 30rpx;
  padding: 10rpx 32rpx;
  box-sizing: border-box;
  box-shadow: 0 20rpx 50rpx rgba(59, 130, 246, 0.16);
}

.field {
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #e8f0fa;
}

.field:last-child {
  border-bottom: none;
}

.f-icon {
  font-size: 32rpx;
  margin-right: 18rpx;
}

.input {
  flex: 1;
  height: 104rpx;
  font-size: 30rpx;
  color: #24457a;
}

.login-btn {
  width: 100%;
  margin-top: 48rpx;
  box-shadow: 0 16rpx 36rpx rgba(59, 130, 246, 0.3);
}

.hint {
  margin-top: 30rpx;
  font-size: 23rpx;
  color: rgba(22, 64, 122, 0.55);
  text-align: center;
}
